{
  "name": "toolbox-desktop",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node electron/dev-runner.js",
    "compile:electron": "tsc -p electron/tsconfig.json",
    "build:frontend": "npm --prefix frontend run build",
    "electron": "electron .",
    "dev:backend": "uv run --directory backend uvicorn app.main:app --host 127.0.0.1 --port 4740 --reload"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "~5.7.0"
  },
  "build": {
    "appId": "com.toolbox.app",
    "productName": "工具盒子",
    "directories": { "output": "release" },
    "files": ["package.json", "electron/**/*.js"],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend/dist",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["dir", "nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "工具盒子"
    }
  }
}
