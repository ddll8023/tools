{
  "name": "toolbox-desktop",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node electron/dev-runner.js",
    "compile:electron": "tsc -p electron/tsconfig.json",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "node scripts/build-backend-runtime.js",
    "build:usb-native": "node scripts/build-usb-native.js",
    "build:release": "npm run build:frontend && npm run compile:electron && npm run build:backend",
    "package:portable": "npm run build:release && node scripts/package-portable.mjs",
    "package:mac": "npm run build:release && node scripts/package-portable.mjs --mac",
    "package:win": "npm run build:release && node scripts/package-portable.mjs --win",
    "electron": "electron .",
    "dev:backend": "uv run --directory backend uvicorn toolbox_backend.main:app --app-dir src --host 127.0.0.1 --port 18740 --reload"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^24.13.3",
    "typescript": "~5.7.0"
  },
  "build": {
    "appId": "com.toolbox.app",
    "productName": "工具盒子",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "electron/**/*.js",
      "frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "build/backend-runtime",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "artifactName": "toolbox-${version}-${os}-${arch}.${ext}",
      "target": [
        "zip"
      ],
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "14.0",
      "sign": "./scripts/sign-macos.js"
    },
    "win": {
      "artifactName": "toolbox-${version}-${os}-${arch}.${ext}",
      "target": [
        "zip"
      ]
    }
  },
  "allowScripts": {
    "electron@43.2.0": true
  }
}
