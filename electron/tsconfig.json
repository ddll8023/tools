{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2023", "DOM"],
    "outDir": ".",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "main.ts",
    "preload.ts",
    "update-helper.ts",
    "markdown-to-pdf.ts",
    "markdown-to-pdf-types.ts",
    "markdown-source.ts",
    "markdown-source-types.ts"
  ],
  "exclude": []
}
